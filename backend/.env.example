# ================================================================
# SCHOOL ERP BACKEND CONFIGURATION
# ================================================================
PORT=5000
NODE_ENV=development

# Database Connection URL:
# For Local PostgreSQL: postgresql://postgres:password@localhost:5432/school_erp_db
# For Cloud PostgreSQL (Supabase / Neon / Render): postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/school_erp_db"

# Security Secrets (Replace with random strings for production)
JWT_SECRET="school_erp_jwt_secret_key_change_me_2083"
COOKIE_SECRET="school_erp_cookie_secret_key_change_me_2083"
JWT_EXPIRES_IN="7d"

# Default Initial Administrator Password (Used by seed script)
INITIAL_ADMIN_PASSWORD="Admin@123"

# Upload Directory
UPLOAD_DIR="./uploads"

# Optional Email / Notification settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
